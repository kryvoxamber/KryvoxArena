{
  "name": "kryvox-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Free Fire & BGMI esports tournament platform (frontend + Supabase backend in one repo)",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/crypto.test.ts tests/payments.test.ts tests/templates.test.ts",
